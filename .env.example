# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Every variable uses the CAREER_ prefix (see app/core/config.py).
#
# Leave CAREER_ENABLE_REAL_AI=false to run the deterministic mock backend with
# zero external dependencies (this is what the test suite uses).

# --- Master switch ---
CAREER_ENABLE_REAL_AI=false

# --- Local database ---
# Defaults to app/data/career_helper.sqlite3. If this runtime database is
# missing, it is copied from app/data/career_helper_initial.sqlite3.
CAREER_LOCAL_DATABASE_PATH=app/data/career_helper.sqlite3

# --- Chat LLM (OpenAI-compatible) ---
CAREER_LLM_API_KEY=
# Optional: point at a proxy / domestic OpenAI-compatible gateway.
# CAREER_LLM_BASE_URL=https://api.openai.com/v1
CAREER_LLM_TEMPERATURE=0.2
CAREER_LLM_TIMEOUT=60

# Per-purpose models (use stronger models for writing/scoring, cheaper for extraction).
CAREER_LLM_CV_MODEL=gpt-4o-mini
CAREER_LLM_ONBOARDING_MODEL=gpt-4o-mini
CAREER_LLM_TAILORED_CV_MODEL=gpt-4o
CAREER_LLM_INTERVIEW_MODEL=gpt-4o

# Conversational onboarding target question count (drives totalQuestions).
CAREER_ONBOARDING_TARGET_QUESTIONS=6

# --- Voice (STT/TTS) ---
CAREER_VOICE_PROVIDER=openai
# Optional separate credentials for voice; fall back to the LLM ones when empty.
CAREER_VOICE_API_KEY=
# CAREER_VOICE_BASE_URL=https://api.openai.com/v1
CAREER_STT_MODEL=whisper-1
CAREER_TTS_MODEL=tts-1
CAREER_TTS_VOICE=alloy
